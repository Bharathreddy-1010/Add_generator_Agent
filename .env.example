# CrowdWisdomTrading Hermes Video Ads Agent Configuration

# ========================================================
# RUNTIME MODE
# Set to 'true' to run fully offline using realistic, verified fixtures
# Set to 'false' to call external APIs (Apify, Tavily, OpenRouter/Nvidia)
# ========================================================
DEMO_MODE=true

# ========================================================
# LLM PROVIDER CONFIGURATION
# Supported providers: 'openrouter' or 'nvidia'
# ========================================================
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

# NVIDIA Build alternative (https://build.nvidia.com/)
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# ========================================================
# DATA SCRAPING & RESEARCH APIS
# ========================================================
# Apify token for Meta Ads scraping (https://apify.com/)
APIFY_API_TOKEN=

# Tavily API key for targeted ICP pain & market search (https://tavily.com/)
TAVILY_API_KEY=

# Exa API key (optional alternative to Tavily, https://exa.ai/)
EXA_API_KEY=

# ========================================================
# OUTPUT & RENDERING CONFIGURATION
# ========================================================
VIDEO_RESOLUTION_WIDTH=1080
VIDEO_RESOLUTION_HEIGHT=1920
VIDEO_FPS=30
VOICEOVER_ENABLED=true
VOICEOVER_VOICE=Samantha
DEBUG_LOGGING=false
